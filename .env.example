# NextAuth v5
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Site URL (used for canonical links, OG, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense (optional — leave empty to show placeholder)
# 1. Create a display ad unit in Google AdSense dashboard
# 2. Set the ad unit slot ID here (e.g., "1234567890")
# 3. Ensure /ads.txt is deployed to the site root
NEXT_PUBLIC_ADSENSE_AD_UNIT=

# Waffo Pancake — Merchant of Record payment (P1-2)
# Get these from Dashboard → Settings → Developers
WAFFO_MERCHANT_ID=MER_xxx
WAFFO_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# From Dashboard → Products → click product (shown in URL)
WAFFO_PRODUCT_ID=PROD_xxx
# From Dashboard → Settings → Store Profile
WAFFO_STORE_ID=STO_xxx

# Database (P1-0) — Neon PostgreSQL connection string
# Provision a Neon project, then paste the pooled connection string here.
# When empty, the app runs in DB-less mode: account page shows Free and
# webhook persistence is skipped (graceful degradation).
DATABASE_URL=
