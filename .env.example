# NextAuth v5
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Site URL (used for canonical links, OG, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense (optional — leave empty to show placeholder)
# 1. Create a display ad unit in Google AdSense dashboard
# 2. Set the ad unit slot ID here (e.g., "1234567890")
# 3. Ensure /ads.txt is deployed to the site root
NEXT_PUBLIC_ADSENSE_AD_UNIT=
