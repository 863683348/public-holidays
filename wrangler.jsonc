{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "public-holidays",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// KV namespace for ISR incremental cache (binding name NEXT_INC_CACHE_KV).
	// DORMANT since 2026-08-14: open-next.config.ts now uses the default "dummy"
	// cache, so this binding is NOT written to at runtime/deploy (avoids the
	// Free-plan 1,000-writes/day quota that blocked deploys with error 10048).
	// Kept here so re-enabling kvIncrementalCache on the $5 Paid plan is a
	// one-line change. If you remove it, also drop the override in
	// open-next.config.ts.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "301d285cf9504e489723cb1015d73948" }
	]
}
