{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "public-holidays",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// P0 - KV namespace for ISR incremental cache (binding name must be NEXT_INC_CACHE_KV)
	// Steps:
	//   1) Create it:  npx wrangler kv namespace create NEXT_INC_CACHE_KV
	//   2) Paste the returned id below (replace <KV_NAMESPACE_ID>)
	//   3) Deploy:     npm run deploy
	// Note: id must be a real 32-char hex or `wrangler deploy` will fail validation.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "<KV_NAMESPACE_ID>" }
	]
}
