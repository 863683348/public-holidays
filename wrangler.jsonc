{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "public-holidays",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// P0 — ISR 增量缓存用的 KV 命名空间（绑定名必须叫 NEXT_INC_CACHE_KV，与 open-next.config.ts 对应）
	// 落地步骤：
	//   1) 创建命名空间：  npx wrangler kv namespace create NEXT_INC_CACHE_KV
	//   2) 把命令返回的 id 填到下面（替换 <KV_NAMESPACE_ID>）
	//   3) 再部署：        npm run deploy
	// 注意：id 必须是真实 32 位十六进制，否则 wrangler deploy 会校验失败。
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "<KV_NAMESPACE_ID>" }
	]
}
